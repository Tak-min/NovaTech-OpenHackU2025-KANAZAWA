# PostgreSQL
POSTGRES_USER=myuser
POSTGRES_PASSWORD=replace_with_local_db_password
POSTGRES_DB=hare_ame_db
DATABASE_URL=postgres://myuser:replace_with_local_db_password@db:5432/hare_ame_db

# Backend
PORT=3000
JWT_SECRET=change_me_to_a_long_random_secret
WEATHER_API_KEY=your_openweathermap_api_key

# Location logging
# Hackathon/demo default: keep weather logs responsive.
LOG_LOCATION_MIN_INTERVAL_SECONDS=1

# Number of decimal places exposed for other users' map coordinates.
# 3 decimals is roughly 100m; lower values are more private.
LOCATION_PUBLIC_PRECISION_DECIMALS=3

# Optional: comma-separated frontend origins for CORS.
# FRONTEND_ORIGINS=https://example.com,https://foo.example
